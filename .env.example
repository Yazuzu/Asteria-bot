# ==========================================
# ASTERIA-BOT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values

# Discord Bot Token (required)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Bot Owner IDs (comma-separated, no spaces)
# Get your ID: Enable Developer Mode in Discord, right-click user → Copy User ID
OWNER_IDS=123456789,987654321

# ==========================================
# LLM Configuration (KoboldCPP)
# ==========================================
# URL to your KoboldCPP instance
KOBOLD_URL=http://localhost:5001/api/v1/generate

# Generation parameters
TEMPERATURE=0.70
REPETITION_PENALTY=1.15
TOP_P=0.95
TOP_K=40
MAX_CONTEXT_LENGTH=4096

# Token limits per response type
CASUAL_MAX_TOKENS=80
RP_MAX_TOKENS=300

# ==========================================
# Memory System
# ==========================================
# Maximum recent messages to keep in context
MAX_MEMORY_MESSAGES=6

# Memory retention in days
MEMORY_RETENTION_DAYS=30

# Similarity threshold for memory cache (0-1)
CACHE_SIMILARITY_THRESHOLD=0.98

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# ==========================================
# AI Models (Hugging Face)
# ==========================================
# Emotion detection model
EMOTION_MODEL=bhavesh-thakkar01/go-emotion-distilbert

# Text embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# Advanced Features
# ==========================================
# Enable PersonaReAct (two-call strategy)
USE_PERSONA_REACT=True

# Use Density Matrix for memory reranking
USE_DENSITY_RERANK=True

# Enable performance logging
ENABLE_PERF_LOGGING=True

# ==========================================
# Optional: Mem0 Integration
# ==========================================
# Enable Mem0 (advanced memory platform)
USE_MEM0=False

# Note: Mem0 requires additional configuration
# See: https://docs.mem0.ai/
